    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/link2.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- J2 offset: origin rotated +90deg around joint Z so arm hangs down at J2=0.
       Original rpy="1.5707963 3.1415926 0", limits -1.74/1.74 -->
  <joint name="left_joint2" type="revolute">
    <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
    <parent link="left_link1"/>
    <child link="left_link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.3108" upper="0.1692" effort="100" velocity="5"/>
  </joint>

  <link name="left_link3">
