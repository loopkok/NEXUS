<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  Dual-Arm Dual-Hand URDF: two nero arms + two xhand hands on a T-bracket.

  Left  arm: mounted at Y=-0.1975, rpy=" 1.5708 -1.5708 0" (Ry-90 + Rx+90)
  Right arm: mounted at Y=+0.1975, rpy="-1.5708 -1.5708 0" (Ry-90 + Rx-90)

  Joint2 offset by +90deg so arm hangs down naturally at J2=0 (was J2=90deg).

  Connector link origin = hand-link origin (STL origin at hand face).
  Connector STL is in mm, scaled by 0.001. Mesh flipped Rx(pi) so body
  extends from hand toward flange (-Z in connector frame).

  Hand Z-axis = flange Z-axis direction. Hands rotated 180deg around Z.
  ============================================================================ -->
<robot name="xhand_nero">

  <!-- ======================================================================= -->
  <!--  WORLD — ground fixed point                                             -->
  <!-- ======================================================================= -->
  <link name="world"/>

  <joint name="ground_to_bracket" type="fixed">
    <parent link="world"/>
    <child link="t_bracket_base"/>
    <origin xyz="0 0 0.860" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  T-BRACKET BASE — mounting reference frame (no geometry)                -->
  <!-- ======================================================================= -->
  <link name="t_bracket_base"/>


  <!-- ======================================================================= -->
  <!--  LEFT ARM MOUNT                                                         -->
  <!-- ======================================================================= -->
  <joint name="left_arm_mount" type="fixed">
    <parent link="t_bracket_base"/>
    <child link="left_base_link"/>
    <origin xyz="0 -0.1975 0" rpy="1.5708 -1.5708 0"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  LEFT ARM: base_link + link1-7 + joints                                 -->
  <!-- ======================================================================= -->
  <link name="left_base_link">
    <inertial>
      <origin xyz="-0.00319465997 -0.00005467608 0.04321758463" rpy="0 0 0"/>
      <mass value="1.06458435"/>
      <inertia ixx="0.00102659855152" ixy="0.00000186219753" ixz="-0.00000295298037" iyy="0.00114399299508" iyz="-0.00000078763492" izz="0.00090872933022"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/dae/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/base_link.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="left_link1">
    <inertial>
      <origin xyz="-0.00076810578 -0.00005718031 -0.00686372765" rpy="0 0 0"/>
      <mass value="0.76710504"/>
      <inertia ixx="0.00066689512233" ixy="0.00000273938306" ixz="0.00001463284987" iyy="0.00054501235592" iyz="0.00000183168344" izz="0.00051509465737"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/dae/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/link1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_joint1" type="revolute">
    <origin xyz="0 0 0.138" rpy="0 0 0"/>
    <parent link="left_base_link"/>
    <child link="left_link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.70526" upper="2.70526" effort="100" velocity="5"/>
  </joint>

  <link name="left_link2">
    <inertial>
      <origin xyz="0.00079686657 -0.07890325930 0.00111849422" rpy="0 0 0"/>
      <mass value="0.69381908"/>
      <inertia ixx="0.00201093857656" ixy="-0.00002399426785" ixz="-0.00000072824714" iyy="0.00063544232555" iyz="0.00005831284343" izz="0.00181943989593"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xhand_nero_description/meshes/nero/dae/link2.dae"/>
