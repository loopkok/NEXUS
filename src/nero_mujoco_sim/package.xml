<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nero_mujoco_sim</name>
  <version>0.1.0</version>
  <description>Physics-backed MuJoCo simulation for the NEXUS Nero dual-arm and XHand assembly.</description>
  <maintainer email="maintainer@example.com">NEXUS</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nexus_core</exec_depend>
  <exec_depend>xhand_nero_description</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
