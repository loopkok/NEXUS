<?xml version="1.0"?>
<package format="3">
  <name>nexus_core</name>
  <version>0.1.0</version>
  <description>Profile contracts, command arbitration and ROS adapters for NEXUS.</description>
  <maintainer email="maintainer@example.com">NEXUS</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>xhand_control_interfaces</exec_depend>
  <exec_depend>wujihand_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
