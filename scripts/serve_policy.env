# serve_policy.env — serve.py 启动参数（外置，脚本只读此文件，改参不动脚本）
#
# 用法：编辑本文件 → `./serve_policy.sh` 启动；CLI 可临时覆盖部分参数：
#   ./serve_policy.sh --port 8002 --config /path/other.env
# 完整参数见 serve_policy.sh --help 注释。

# ---- 环境 ----
# GPU 主机上的 py3.12 lerobot 环境（serve ACT 用；pi05 需 openpi env，可另设）
PY=/home/robot/miniconda3/envs/lerobot/bin/python

# ---- 模型 ----
# 模型族: act(lerobot) | pi05(openpi)
MODEL=act
# act=lerobot checkpoint 目录（含 config.json + model.safetensors + pre/postprocessor）
# pi05=openpi 格式 checkpoint（含 params/ 或 model.safetensors + assets/<id>/norm_stats.json）
CHECKPOINT_DIR=/home/robot/loopkok/sdk/astral_ckpt/pickup_act_480/checkpoints/080000/pretrained_model
# ---- 网络 ----
# 0.0.0.0 = 所有网卡（直连/局域网都收）；只对本机=127.0.0.1
HOST=0.0.0.0
# 端口：启动脚本会先检查该端口是否已被占用（占用则拒绝启动，除非先 --stop）
PORT=8001

# ---- 推理参数 ----
# 动作维度（与机器人 schema 一致，本机单左臂+左夹爪=8）
ACTION_DIM=8
# 模型槽位 -> 相机 label（须与节点 camera_map 一致）
SLOT_MAP='{"base_0_rgb": "video8", "left_wrist_0_rgb": "video0"}'
# 缺省语言指令（运行中节点可随时改）
DEFAULT_PROMPT=""
# torch device（act 用；留空=自动）
DEVICE=""
# pi05 用：openpi 训练配置名
POLICY_CONFIG=pi05_astral

# ---- 运行目录 ----
# 日志与 pid 文件目录（自动创建）
LOG_DIR=/tmp/astral_serve
